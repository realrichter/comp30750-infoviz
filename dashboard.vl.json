{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Ireland's monthly goods trade, Jan 2015 - Sep 2026 (CSO table TSM10). Four linked views: summary numbers, monthly area chart (drag to pick a period), partner x month heatmap, partner ranking and goods breakdown (click to pick the highlighted slice).",
  "title": {
    "text": "Ireland's goods trade by partner and product, 2015–2026",
    "subtitle": "Drag on the monthly chart to pick a period. Click a partner or goods class to highlight it. Source: CSO TSM10, goods only, not seasonally adjusted.",
    "fontSize": 16,
    "offset": 20
  },
  "params": [
    {
      "name": "flow",
      "value": "Exports",
      "bind": {"input": "radio", "options": ["Exports", "Imports", "Balance"], "name": "Show: ", "element": "#controls"}
    },
    {
      "name": "pickPartner",
      "description": "Defined at the top level so one selection works in the Partners bars and all three map panels. Clicks only count on marks that carry a partner.",
      "views": ["partners", "mapAmericas", "mapEurope", "mapAsia"],
      "select": {"type": "point", "fields": ["partner"], "clear": "dblclick",
                 "on": "click[event.item && event.item.datum && isValid(event.item.datum.partner)]"}
    }
  ],
  "config": {
    "view": {"stroke": null},
    "title": {"anchor": "start"}
  },
  "resolve": {"scale": {"color": "independent", "fill": "independent"}, "legend": {"color": "independent", "fill": "independent"}},
  "spacing": 36,
  "vconcat": [
    {
      "description": "Summary numbers for the selected period. joinaggregate keeps the period totals on every row before the partner/goods filters, so the slice's share can be calculated.",
      "width": 760,
      "height": 44,
      "data": {"url": "data/monthly_trade.csv", "format": {"type": "csv", "parse": {"year": "number", "month": "number", "exports": "number", "imports": "number"}}},
      "transform": [
        {"calculate": "datetime(datum.year, datum.month - 1, 1)", "as": "date"},
        {"calculate": "flow == 'Exports' ? datum.exports : flow == 'Imports' ? datum.imports : datum.exports - datum.imports", "as": "value"},
        {"filter": {"param": "period"}},
        {
          "joinaggregate": [
            {"op": "sum", "field": "exports", "as": "allExports"},
            {"op": "sum", "field": "imports", "as": "allImports"},
            {"op": "sum", "field": "value", "as": "allValue"},
            {"op": "min", "field": "date", "as": "first"},
            {"op": "max", "field": "date", "as": "last"}
          ]
        },
        {"filter": {"param": "pickPartner"}},
        {"filter": {"param": "pickGoods"}},
        {
          "aggregate": [
            {"op": "sum", "field": "value", "as": "sliceValue"},
            {"op": "max", "field": "allExports", "as": "allExports"},
            {"op": "max", "field": "allImports", "as": "allImports"},
            {"op": "max", "field": "allValue", "as": "allValue"},
            {"op": "min", "field": "first", "as": "first"},
            {"op": "max", "field": "last", "as": "last"}
          ]
        },
        {"calculate": "timeFormat(datum.first, '%b %Y') + ' – ' + timeFormat(datum.last, '%b %Y')", "as": "Period"},
        {"calculate": "'€' + format(datum.allExports / 1000, ',.1f') + 'bn'", "as": "Exports"},
        {"calculate": "'€' + format(datum.allImports / 1000, ',.1f') + 'bn'", "as": "Imports"},
        {"calculate": "'€' + format((datum.allExports - datum.allImports) / 1000, ',.1f') + 'bn'", "as": "Balance"},
        {"calculate": "format(datum.sliceValue / datum.allValue, '.0%')", "as": "Highlighted slice share"},
        {"fold": ["Period", "Exports", "Imports", "Balance", "Highlighted slice share"], "as": ["label", "text"]},
        {"calculate": "datum.label == 'Highlighted slice share' ? 'Highlighted, % of ' + lower(flow) : datum.label", "as": "caption"},
        {"calculate": "indexof(['Period', 'Exports', 'Imports', 'Balance', 'Highlighted slice share'], datum.label)", "as": "i"},
        {"calculate": "datum.i == 0 ? 0 : 50 + 150 * datum.i", "as": "xpos", "description": "Period gets a wider first column; the four numbers are evenly spaced after it"}
      ],
      "encoding": {
        "x": {"field": "xpos", "type": "quantitative", "scale": null}
      },
      "layer": [
        {"mark": {"type": "text", "align": "left", "fontWeight": "bold", "color": "#222", "y": 12},
         "encoding": {"text": {"field": "text"},
                      "size": {"condition": {"test": "datum.label == 'Period'", "value": 15}, "value": 20}}},
        {"mark": {"type": "text", "align": "left", "fontSize": 11, "color": "#666", "y": 36},
         "encoding": {"text": {"field": "caption"}}}
      ]
    },
    {
      "description": "Monthly time series. Grey area = all trade for the chosen flow, coloured area = the highlighted slice. The interval selection 'period' filters the summary, ranking and goods views.",
      "width": 760,
      "height": 220,
      "title": {"text": "Monthly trade", "subtitle": "€ million per month. Grey: all trade. Colour: highlighted"},
      "data": {"url": "data/monthly_trade.csv", "format": {"type": "csv", "parse": {"year": "number", "month": "number", "exports": "number", "imports": "number"}}},
      "layer": [
        {
          "description": "All trade",
          "transform": [
            {"calculate": "flow == 'Exports' ? datum.exports : flow == 'Imports' ? datum.imports : datum.exports - datum.imports", "as": "value"},
            {"aggregate": [{"op": "sum", "field": "value", "as": "total"}], "groupby": ["year", "month"]},
            {"calculate": "datetime(datum.year, datum.month - 1, 1)", "as": "date"}
          ],
          "params": [{"name": "period", "select": {"type": "interval", "encodings": ["x"]}}],
          "mark": {"type": "area", "interpolate": "step-after", "color": "#dcdcd8"},
          "encoding": {
            "x": {"field": "date", "type": "temporal", "title": null, "axis": {"format": "%Y", "tickCount": "year", "grid": false}},
            "y": {"field": "total", "type": "quantitative", "title": null,
                  "axis": {"minExtent": 120, "maxExtent": 120, "tickCount": 5}}
          }
        },
        {
          "description": "Highlighted slice = rows matching the picked partners and goods",
          "transform": [
            {"filter": {"param": "pickPartner"}},
            {"filter": {"param": "pickGoods"}},
            {"calculate": "flow == 'Exports' ? datum.exports : flow == 'Imports' ? datum.imports : datum.exports - datum.imports", "as": "value"},
            {"aggregate": [{"op": "sum", "field": "value", "as": "total"}], "groupby": ["year", "month"]},
            {"calculate": "datetime(datum.year, datum.month - 1, 1)", "as": "date"}
          ],
          "mark": {"type": "area", "interpolate": "step-after",
                   "color": {"expr": "flow == 'Exports' ? '#2b6cb0' : flow == 'Imports' ? '#c95f22' : '#555555'"}},
          "encoding": {
            "x": {"field": "date", "type": "temporal"},
            "y": {"field": "total", "type": "quantitative"}
          }
        },
        {
          "description": "Hover rule with tooltip (nearest month). joinaggregate keeps each month's total before the slice filters, so the tooltip can show slice and share.",
          "transform": [
            {"calculate": "flow == 'Exports' ? datum.exports : flow == 'Imports' ? datum.imports : datum.exports - datum.imports", "as": "value"},
            {"joinaggregate": [{"op": "sum", "field": "value", "as": "monthTotal"}], "groupby": ["year", "month"]},
            {"filter": {"param": "pickPartner"}},
            {"filter": {"param": "pickGoods"}},
            {"aggregate": [{"op": "sum", "field": "value", "as": "slice"},
                           {"op": "max", "field": "monthTotal", "as": "monthTotal"}],
             "groupby": ["year", "month"]},
            {"calculate": "datetime(datum.year, datum.month - 1, 1)", "as": "date"},
            {"calculate": "datum.slice / datum.monthTotal", "as": "share"}
          ],
          "params": [{"name": "hover", "select": {"type": "point", "fields": ["date"], "nearest": true, "on": "pointerover", "clear": "pointerout"}}],
          "mark": {"type": "rule", "color": "#333"},
          "encoding": {
            "x": {"field": "date", "type": "temporal"},
            "opacity": {"condition": {"param": "hover", "empty": false, "value": 0.5}, "value": 0},
            "tooltip": [
              {"field": "date", "type": "temporal", "timeUnit": "yearmonth", "title": "Month"},
              {"field": "monthTotal", "type": "quantitative", "format": ",.0f", "title": "All trade (€m)"},
              {"field": "slice", "type": "quantitative", "format": ",.0f", "title": "Highlighted slice (€m)"},
              {"field": "share", "type": "quantitative", "format": ".0%", "title": "Slice share"}
            ]
          }
        },
        {
          "description": "Annotations (facts from the data, no claims about causes). The two 2025 labels are computed for the current flow, so they always match the bar they point at.",
          "layer": [
            {
              "description": "Event marker: Brexit",
              "data": {"values": [{"date": "2021-01-01", "note": "Brexit"}]},
              "layer": [
                {"mark": {"type": "rule", "color": "#888", "strokeWidth": 0.75},
                 "encoding": {"x": {"field": "date", "type": "temporal"}, "y": {"value": 14}, "y2": {"value": 220}}},
                {"mark": {"type": "text", "align": "left", "dx": 4, "fontSize": 10, "color": "#555"},
                 "encoding": {"x": {"field": "date", "type": "temporal"}, "y": {"value": 26}, "text": {"field": "note"}}}
              ]
            },
            {
              "description": "Value markers: March and September 2025, labelled with the value for the current flow. March 2025 is the record month for exports and for the balance, not for imports.",
              "transform": [
                {"filter": "datum.year == 2025 && (datum.month == 3 || datum.month == 9)"},
                {"calculate": "flow == 'Exports' ? datum.exports : flow == 'Imports' ? datum.imports : datum.exports - datum.imports", "as": "value"},
                {"aggregate": [{"op": "sum", "field": "value", "as": "total"}], "groupby": ["year", "month"]},
                {"calculate": "datetime(datum.year, datum.month - 1, 1)", "as": "date"},
                {"calculate": "(datum.month == 3 && flow != 'Imports' ? 'Record, ' : '') + '€' + format(datum.total / 1000, '.1f') + 'bn'", "as": "note"}
              ],
              "layer": [
                {"mark": {"type": "rule", "color": "#888", "strokeWidth": 0.75},
                 "encoding": {"x": {"field": "date", "type": "temporal"}, "y": {"value": 14}, "y2": {"value": 220}}},
                {"transform": [{"filter": "datum.month == 3"}],
                 "mark": {"type": "text", "align": "right", "dx": -4, "fontSize": 10, "color": "#555"},
                 "encoding": {"x": {"field": "date", "type": "temporal"}, "y": {"value": 8}, "text": {"field": "note"}}},
                {"transform": [{"filter": "datum.month == 9"}],
                 "mark": {"type": "text", "align": "left", "dx": 4, "fontSize": 10, "color": "#555"},
                 "encoding": {"x": {"field": "date", "type": "temporal"}, "y": {"value": 8}, "text": {"field": "note"}}}
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "Heatmap (single months) and map (average month over the selected period) show different quantities, so each has its own colour range and legend. Ranges are fixed per Show mode (not re-fitted on every click) so colours stay comparable while brushing; values beyond the range are clamped and the end labels say so.",
      "spacing": 36,
      "resolve": {"scale": {"color": "independent"}, "legend": {"color": "independent"}},
      "vconcat": [
        {
          "description": "Heatmap: top 15 partners x month, same time axis as the chart above. Colour follows the Show switch: sequential white-to-blue for exports, white-to-orange for imports (values are never negative), diverging orange-white-blue only for the balance, which really has a sign. Square-root scale so mid-sized partners stay visible next to the US outlier.",
          "width": 760,
          "height": 225,
          "title": "Monthly trade by partner",
          "data": {"url": "data/monthly_trade.csv", "format": {"type": "csv", "parse": {"year": "number", "month": "number", "exports": "number", "imports": "number"}}},
          "transform": [
            {"lookup": "partner", "from": {"data": {"url": "data/partner_rank.csv"}, "key": "partner", "fields": ["rank"]}},
            {"calculate": "toNumber(datum.rank)", "as": "rank"},
            {"filter": "isValid(datum.rank) && datum.rank <= 15"},
            {"filter": {"param": "pickGoods"}},
            {"calculate": "flow == 'Exports' ? datum.exports : flow == 'Imports' ? datum.imports : datum.exports - datum.imports", "as": "value"},
            {"aggregate": [{"op": "sum", "field": "value", "as": "value"},
                           {"op": "sum", "field": "exports", "as": "exports"},
                           {"op": "sum", "field": "imports", "as": "imports"}],
             "groupby": ["partner", "rank", "year", "month"]},
            {"calculate": "datetime(datum.year, datum.month - 1, 1)", "as": "date"},
            {"calculate": "datetime(datum.year, datum.month, 1)", "as": "nextMonth"}
          ],
          "mark": "rect",
          "encoding": {
            "x": {"field": "date", "type": "temporal", "title": null, "axis": {"format": "%Y", "tickCount": "year", "grid": false}},
            "x2": {"field": "nextMonth"},
            "y": {"field": "partner", "type": "nominal", "title": null,
                  "sort": {"field": "rank", "op": "min", "order": "ascending"},
                  "axis": {"minExtent": 120, "maxExtent": 120, "ticks": false, "domain": false}},
            "color": {
              "field": "value", "type": "quantitative",
              "scale": {"type": "sqrt", "clamp": true, "interpolate": "lab",
                        "domain": {"expr": "flow == 'Exports' ? [0, 25000] : flow == 'Imports' ? [0, 3000] : [-25000, 25000]"},
                        "scheme": {"expr": "flow == 'Exports' ? ['#f2f0eb', '#c5deec', '#7db6d6', '#3b83b9', '#134b85'] : flow == 'Imports' ? ['#f2f0eb', '#fcd8a9', '#f2a952', '#ce7416', '#994a07'] : ['#994a07', '#ce7416', '#f2a952', '#fcd8a9', '#f2f0eb', '#c5deec', '#7db6d6', '#3b83b9', '#134b85']"}},
              "legend": {"title": "€ million per month", "orient": "bottom", "direction": "horizontal", "gradientLength": 360, "titleLimit": 500,
                         "values": {"expr": "flow == 'Exports' ? [0, 1000, 5000, 10000, 25000] : flow == 'Imports' ? [0, 500, 1000, 2000, 3000] : [-25000, -5000, 0, 5000, 25000]"},
                         "labelExpr": "(datum.value == (flow == 'Imports' ? 3000 : 25000) ? '≥ ' : datum.value == -25000 ? '≤ ' : '') + datum.label"}
            },
            "opacity": {"condition": {"param": "period", "value": 1}, "value": 0.3},
            "tooltip": [
              {"field": "partner", "title": "Partner"},
              {"field": "date", "type": "temporal", "timeUnit": "yearmonth", "title": "Month"},
              {"field": "exports", "type": "quantitative", "format": ",.0f", "title": "Exports (€m)"},
              {"field": "imports", "type": "quantitative", "format": ",.0f", "title": "Imports (€m)"}
            ]
          }
        },
        {
          "description": "Regional small multiples of the 20 named partners (Americas, Europe, Asia), each cropped to its partners on a flat Mercator projection so every partner is large enough to read and click. Colour = average € million per month in the selected period, for the picked goods, with its own colour range sized for averages (legend under the panels). White = not a top-20 partner (pooled as Rest of world). Click a country = pickPartner.",
          "title": {"text": "Where the trade went", "subtitle": "Average month in the selected period. White: no data.", "dx": -120},
          "spacing": 20,
          "resolve": {"scale": {"color": "shared"}, "legend": {"color": "shared"}},
          "data": {"url": "data/monthly_trade.csv", "format": {"type": "csv", "parse": {"year": "number", "month": "number", "exports": "number", "imports": "number"}}},
          "transform": [
            {"calculate": "datetime(datum.year, datum.month - 1, 1)", "as": "date"},
            {"filter": {"param": "period"}},
            {"joinaggregate": [{"op": "distinct", "field": "date", "as": "months"}]},
            {"filter": {"param": "pickGoods"}},
            {"calculate": "flow == 'Exports' ? datum.exports : flow == 'Imports' ? datum.imports : datum.exports - datum.imports", "as": "value"},
            {"aggregate": [{"op": "sum", "field": "value", "as": "value"},
                           {"op": "sum", "field": "exports", "as": "exports"},
                           {"op": "sum", "field": "imports", "as": "imports"},
                           {"op": "max", "field": "months", "as": "months"}],
             "groupby": ["partner"]},
            {"lookup": "partner", "from": {"data": {"url": "data/partner_iso.csv", "format": {"type": "csv", "parse": {"iso": "string"}}}, "key": "partner", "fields": ["iso"]}},
            {"filter": "isValid(datum.iso)"},
            {"lookup": "iso", "from": {"data": {"url": "data/world-50m.json", "format": {"type": "topojson", "feature": "countries"}}, "key": "id"}, "as": "geo"},
            {"calculate": "datum.value / datum.months", "as": "value"},
            {"calculate": "datum.exports / datum.months", "as": "exports"},
            {"calculate": "datum.imports / datum.months", "as": "imports"}
          ],
          "hconcat": [
            {
              "title": {"text": "Americas", "fontSize": 11, "fontWeight": "normal"},
              "width": 200,
              "height": 220,
              "projection": {"type": "mercator",
                             "fit": {"type": "Feature", "geometry": {"type": "MultiPoint", "coordinates": [[-127, 14], [-60, 58]]}}},
              "layer": [
                {"description": "All countries: white = not a top-20 partner",
                 "data": {"url": "data/world-50m.json", "format": {"type": "topojson", "feature": "countries"}},
                 "mark": {"type": "geoshape", "fill": "white", "stroke": "#cfcfcf", "strokeWidth": 0.5, "clip": true}},
                {"name": "mapAmericas",
                 "mark": {"type": "geoshape", "stroke": "#999", "strokeWidth": 0.5, "clip": true, "cursor": "pointer"},
                 "encoding": {
                   "shape": {"field": "geo", "type": "geojson"},
                   "color": {"field": "value", "type": "quantitative",
                             "legend": {"title": "€ million, average month", "orient": "bottom", "direction": "horizontal", "gradientLength": 360, "titleLimit": 500,
                                        "values": {"expr": "flow == 'Exports' ? [0, 1000, 5000, 10000] : flow == 'Imports' ? [0, 500, 1000, 2500] : [-5000, -1000, 0, 1000, 5000]"},
                                        "labelExpr": "(datum.value == (flow == 'Exports' ? 10000 : flow == 'Imports' ? 2500 : 5000) ? '≥ ' : datum.value == -5000 ? '≤ ' : '') + datum.label"},
                             "scale": {"type": "sqrt", "clamp": true, "interpolate": "lab",
                                       "domain": {"expr": "flow == 'Exports' ? [0, 10000] : flow == 'Imports' ? [0, 2500] : [-5000, 5000]"},
                                       "scheme": {"expr": "flow == 'Exports' ? ['#f2f0eb', '#c5deec', '#7db6d6', '#3b83b9', '#134b85'] : flow == 'Imports' ? ['#f2f0eb', '#fcd8a9', '#f2a952', '#ce7416', '#994a07'] : ['#994a07', '#ce7416', '#f2a952', '#fcd8a9', '#f2f0eb', '#c5deec', '#7db6d6', '#3b83b9', '#134b85']"}}},
                   "tooltip": [
                     {"field": "partner", "title": "Partner"},
                     {"field": "exports", "type": "quantitative", "format": ",.0f", "title": "Exports, € million per month"},
                     {"field": "imports", "type": "quantitative", "format": ",.0f", "title": "Imports, € million per month"}
                   ]
                 }},
                {"description": "Highlighted partners: outline drawn on top, so neighbours cannot cover it",
                 "transform": [{"filter": {"param": "pickPartner", "empty": false}}],
                 "mark": {"type": "geoshape", "fill": null, "stroke": "#222", "strokeWidth": 1.5, "strokeJoin": "round", "clip": true},
                 "encoding": {"shape": {"field": "geo", "type": "geojson"}}}
              ]
            },
            {
              "title": {"text": "Europe", "fontSize": 11, "fontWeight": "normal"},
              "width": 320,
              "height": 220,
              "projection": {"type": "mercator",
                             "fit": {"type": "Feature", "geometry": {"type": "MultiPoint", "coordinates": [[-11, 36], [36, 64]]}}},
              "layer": [
                {"description": "All countries: white = not a top-20 partner",
                 "data": {"url": "data/world-50m.json", "format": {"type": "topojson", "feature": "countries"}},
                 "mark": {"type": "geoshape", "fill": "white", "stroke": "#cfcfcf", "strokeWidth": 0.5, "clip": true}},
                {"name": "mapEurope",
                 "mark": {"type": "geoshape", "stroke": "#999", "strokeWidth": 0.5, "clip": true, "cursor": "pointer"},
                 "encoding": {
                   "shape": {"field": "geo", "type": "geojson"},
                   "color": {"field": "value", "type": "quantitative",
                             "scale": {"type": "sqrt", "clamp": true, "interpolate": "lab",
                                       "domain": {"expr": "flow == 'Exports' ? [0, 10000] : flow == 'Imports' ? [0, 2500] : [-5000, 5000]"},
                                       "scheme": {"expr": "flow == 'Exports' ? ['#f2f0eb', '#c5deec', '#7db6d6', '#3b83b9', '#134b85'] : flow == 'Imports' ? ['#f2f0eb', '#fcd8a9', '#f2a952', '#ce7416', '#994a07'] : ['#994a07', '#ce7416', '#f2a952', '#fcd8a9', '#f2f0eb', '#c5deec', '#7db6d6', '#3b83b9', '#134b85']"}}},
                   "tooltip": [
                     {"field": "partner", "title": "Partner"},
                     {"field": "exports", "type": "quantitative", "format": ",.0f", "title": "Exports, € million per month"},
                     {"field": "imports", "type": "quantitative", "format": ",.0f", "title": "Imports, € million per month"}
                   ]
                 }},
                {"description": "Highlighted partners: outline drawn on top, so neighbours cannot cover it",
                 "transform": [{"filter": {"param": "pickPartner", "empty": false}}],
                 "mark": {"type": "geoshape", "fill": null, "stroke": "#222", "strokeWidth": 1.5, "strokeJoin": "round", "clip": true},
                 "encoding": {"shape": {"field": "geo", "type": "geojson"}}},
                {"description": "Ireland, outlined for orientation (no value)",
                 "data": {"url": "data/world-50m.json", "format": {"type": "topojson", "feature": "countries"}},
                 "transform": [{"filter": "datum.id == '372'"}],
                 "mark": {"type": "geoshape", "fill": "white", "stroke": "#333", "strokeWidth": 1, "strokeJoin": "round", "clip": true}}
              ]
            },
            {
              "title": {"text": "Asia", "fontSize": 11, "fontWeight": "normal"},
              "width": 200,
              "height": 220,
              "projection": {"type": "mercator",
                             "fit": {"type": "Feature", "geometry": {"type": "MultiPoint", "coordinates": [[72, 0], [146, 50]]}}},
              "layer": [
                {"description": "All countries: white = not a top-20 partner",
                 "data": {"url": "data/world-50m.json", "format": {"type": "topojson", "feature": "countries"}},
                 "mark": {"type": "geoshape", "fill": "white", "stroke": "#cfcfcf", "strokeWidth": 0.5, "clip": true}},
                {"name": "mapAsia",
                 "mark": {"type": "geoshape", "stroke": "#999", "strokeWidth": 0.5, "clip": true, "cursor": "pointer"},
                 "encoding": {
                   "shape": {"field": "geo", "type": "geojson"},
                   "color": {"field": "value", "type": "quantitative",
                             "scale": {"type": "sqrt", "clamp": true, "interpolate": "lab",
                                       "domain": {"expr": "flow == 'Exports' ? [0, 10000] : flow == 'Imports' ? [0, 2500] : [-5000, 5000]"},
                                       "scheme": {"expr": "flow == 'Exports' ? ['#f2f0eb', '#c5deec', '#7db6d6', '#3b83b9', '#134b85'] : flow == 'Imports' ? ['#f2f0eb', '#fcd8a9', '#f2a952', '#ce7416', '#994a07'] : ['#994a07', '#ce7416', '#f2a952', '#fcd8a9', '#f2f0eb', '#c5deec', '#7db6d6', '#3b83b9', '#134b85']"}}},
                   "tooltip": [
                     {"field": "partner", "title": "Partner"},
                     {"field": "exports", "type": "quantitative", "format": ",.0f", "title": "Exports, € million per month"},
                     {"field": "imports", "type": "quantitative", "format": ",.0f", "title": "Imports, € million per month"}
                   ]
                 }},
                {"description": "Highlighted partners: outline drawn on top, so neighbours cannot cover it",
                 "transform": [{"filter": {"param": "pickPartner", "empty": false}}],
                 "mark": {"type": "geoshape", "fill": null, "stroke": "#222", "strokeWidth": 1.5, "strokeJoin": "round", "clip": true},
                 "encoding": {"shape": {"field": "geo", "type": "geojson"}}}
              ]
            }
          ]
        }
      ]
    },
    {
      "spacing": 40,
      "resolve": {"scale": {"color": "independent"}},
      "hconcat": [
        {
          "name": "partners",
          "title": "Partner ranking",
          "description": "Ranked bars: top 15 partners for the selected period, goods and flow. Click = pickPartner (defined at the top level).",
          "width": 260,
          "height": 300,
          "data": {"url": "data/monthly_trade.csv", "format": {"type": "csv", "parse": {"year": "number", "month": "number", "exports": "number", "imports": "number"}}},
          "transform": [
            {"calculate": "datetime(datum.year, datum.month - 1, 1)", "as": "date"},
            {"filter": {"param": "period"}},
            {"filter": {"param": "pickGoods"}},
            {"filter": "datum.partner != 'Rest of world'"},
            {"calculate": "flow == 'Exports' ? datum.exports : flow == 'Imports' ? datum.imports : datum.exports - datum.imports", "as": "value"},
            {"aggregate": [{"op": "sum", "field": "value", "as": "value"},
                           {"op": "sum", "field": "exports", "as": "exports"},
                           {"op": "sum", "field": "imports", "as": "imports"}],
             "groupby": ["partner"]},
            {"calculate": "abs(datum.value)", "as": "size"},
            {"window": [{"op": "row_number", "as": "position"}], "sort": [{"field": "size", "order": "descending"}]},
            {"filter": "datum.position <= 15"},
            {"calculate": "flow == 'Imports' || datum.value < 0 ? 'orange' : 'blue'", "as": "colour"}
          ],
          "mark": {"type": "bar", "cornerRadiusEnd": 3, "height": 14, "cursor": "pointer"},
          "encoding": {
            "y": {"field": "partner", "type": "nominal", "title": null, "sort": {"field": "size", "order": "descending"},
                  "axis": {"minExtent": 120, "maxExtent": 120}},
            "x": {"field": "value", "type": "quantitative", "title": "€ million", "axis": {"tickCount": 4}},
            "color": {"field": "colour", "type": "nominal", "legend": null,
                      "scale": {"domain": ["blue", "orange"], "range": ["#2b6cb0", "#c95f22"]}},
            "opacity": {"condition": {"param": "pickPartner", "value": 1}, "value": 0.35},
            "tooltip": [
              {"field": "partner", "title": "Partner"},
              {"field": "exports", "type": "quantitative", "format": ",.0f", "title": "Exports (€m)"},
              {"field": "imports", "type": "quantitative", "format": ",.0f", "title": "Imports (€m)"},
              {"field": "value", "type": "quantitative", "format": ",.0f", "title": "Shown (€m)"}
            ]
          }
        },
        {
          "title": "Goods",
          "description": "Diverging bars (tornado): exports right, imports left, for the selected period and partners. Click = pickGoods.",
          "width": 260,
          "height": 300,
          "data": {"url": "data/monthly_trade.csv", "format": {"type": "csv", "parse": {"year": "number", "month": "number", "exports": "number", "imports": "number"}}},
          "transform": [
            {"calculate": "datetime(datum.year, datum.month - 1, 1)", "as": "date"},
            {"filter": {"param": "period"}},
            {"filter": {"param": "pickPartner"}},
            {"aggregate": [{"op": "sum", "field": "exports", "as": "exports"},
                           {"op": "sum", "field": "imports", "as": "imports"}],
             "groupby": ["goods"]},
            {"calculate": "datum.exports + datum.imports", "as": "total"},
            {"calculate": "datum.exports", "as": "Exports"},
            {"calculate": "-datum.imports", "as": "Imports"},
            {"fold": ["Exports", "Imports"], "as": ["Flow", "amount"]}
          ],
          "params": [
            {"name": "pickGoods",
             "select": {"type": "point", "fields": ["goods"], "on": "click", "clear": "dblclick"}}
          ],
          "mark": {"type": "bar", "cornerRadiusEnd": 3, "height": 14, "cursor": "pointer"},
          "encoding": {
            "y": {"field": "goods", "type": "nominal", "title": null, "sort": {"field": "total", "op": "max", "order": "descending"},
                  "axis": {"labelLimit": 195, "minExtent": 200, "maxExtent": 200}},
            "x": {"field": "amount", "type": "quantitative", "title": "€ million",
                  "axis": {"tickCount": 4, "labelExpr": "replace(datum.label, '−', '')"}},
            "color": {"field": "Flow", "type": "nominal",
                      "scale": {"domain": ["Exports", "Imports"], "range": ["#2b6cb0", "#c95f22"]},
                      "legend": {"orient": "bottom", "title": null}},
            "opacity": {"condition": {"param": "pickGoods", "value": 1}, "value": 0.35},
            "tooltip": [
              {"field": "goods", "title": "Goods"},
              {"field": "exports", "type": "quantitative", "format": ",.0f", "title": "Exports (€m)"},
              {"field": "imports", "type": "quantitative", "format": ",.0f", "title": "Imports (€m)"}
            ]
          }
        }
      ]
    }
  ]
}
